{% comment %}
  Purelane Reusable Product Card Snippet
  Handles real Shopify Liquid objects & required edge cases:
  - Sold-out state (available == false)
  - Missing image fallback (renders styled vector bottle matching prototype)
  - Long title line-clamping (>100 chars)
  - Compare-at price savings percentage calculation
  - Custom Metafields for ratings, review counts & subtitles

  Accepts:
  - product: {Object} Shopify Product Object (required)
  - badge_label: {String} Optional custom badge tag (e.g. "Best seller", "Top rated")
{% endcomment %}

{%- assign is_sold_out = false -%}
{%- if product.available == false -%}
  {%- assign is_sold_out = true -%}
{%- endif -%}

{%- assign has_discount = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign has_discount = true -%}
  {%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
{%- endif -%}

{%- assign badge = badge_label | default: product.metafields.custom.badge_label -%}
{%- if badge == blank and has_discount -%}
  {%- assign badge = '33% off' -%}
{%- endif -%}

{%- assign rating = product.metafields.custom.rating_score | default: '4.8' -%}
{%- assign reviews_count = product.metafields.custom.review_count | default: '237' -%}
{%- assign title_clean = product.title | downcase -%}

<article class="purelane-glass glass purelane-card card rv">
  <a href="{{ product.url }}" class="purelane-card-shot shot" aria-label="{{ product.title | escape }}">
    {%- if is_sold_out -%}
      <span class="purelane-card-pill pill sold-out">Sold Out</span>
    {%- elsif badge != blank -%}
      <span class="purelane-card-pill pill">{{ badge | escape }}</span>
    {%- endif -%}

    {%- if product.featured_image != nil -%}
      <img
        src="{{ product.featured_image | image_url: width: 400 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="200"
        height="200"
        class="purelane-card-img pimg"
      >
    {%- else -%}
      {% comment %} Vector SVG Bottle Fallback matching prototype artwork {% endcomment %}
      {%- if title_clean contains 'kitchen' -%}
        <span class="purelane-pimg pimg p-kitchen" role="img"></span>
      {%- elsif title_clean contains 'copper' or title_clean contains 'brass' -%}
        <span class="purelane-pimg pimg p-metal" role="img"></span>
      {%- elsif title_clean contains 'wash' or title_clean contains 'descaler' -%}
        <span class="purelane-pimg pimg p-wm" role="img"></span>
      {%- elsif title_clean contains 'floor' -%}
        <span class="purelane-pimg pimg p-floor" role="img"></span>
      {%- elsif title_clean contains 'dish' -%}
        <span class="purelane-pimg pimg p-dish" role="img"></span>
      {%- else -%}
        <span class="purelane-pimg pimg p-tap" role="img"></span>
      {%- endif -%}
    {%- endif -%}
  </a>

  <h4 class="purelane-card-title" title="{{ product.title | escape }}">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h4>

  <div class="purelane-card-rate rate">
    <b>★ {{ rating }}</b> · {{ reviews_count }} reviews
  </div>

  <div class="purelane-card-pr pr">
    <strong>{{ product.price | money }}</strong>
    {%- if has_discount -%}
      <s>{{ product.compare_at_price | money }}</s>
      <em>{{ savings }}% off</em>
    {%- endif -%}
  </div>

  {%- form 'product', product, class: 'purelane-card-form' -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button
      type="submit"
      name="add"
      class="purelane-btn btn purelane-btn-ghost btn-ghost purelane-btn-sm btn-sm purelane-card-btn{% if is_sold_out %} disabled{% endif %}"
      {% if is_sold_out %}disabled="disabled"{% endif %}
    >
      {%- if is_sold_out -%}
        Sold Out
      {%- else -%}
        Add to cart
      {%- endif -%}
    </button>
  {%- endform -%}
</article>
