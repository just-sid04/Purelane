{%- assign is_sold_out = false -%}
{%- unless product.available -%}{%- assign is_sold_out = true -%}{%- endunless -%}
{%- assign has_discount = false -%}
{%- if product.compare_at_price > product.price -%}{%- assign has_discount = true -%}{%- endif -%}
{%- assign savings = 0 -%}{%- if has_discount -%}{%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}{%- endif -%}
{%- assign badge = badge_label | default: product.metafields.custom.badge_label -%}
{%- assign rating = product.metafields.custom.rating_score -%}
{%- assign reviews_count = product.metafields.custom.review_count -%}
{%- assign title_clean = product.title | downcase -%}

<article class="purelane-glass glass purelane-card card rv">
  <a href="{{ product.url }}" class="purelane-card-shot shot" aria-label="{{ product.title | escape }}">
    {%- if is_sold_out -%}<span class="purelane-card-pill pill sold-out">Sold Out</span>{%- elsif badge != blank -%}<span class="purelane-card-pill pill">{{ badge | escape }}</span>{%- endif -%}
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" class="purelane-card-img pimg">
    {%- else -%}
      {%- if title_clean contains 'kitchen' -%}<span class="purelane-pimg pimg p-kitchen" role="img" aria-label="{{ product.title | escape }}"></span>
      {%- elsif title_clean contains 'copper' or title_clean contains 'brass' -%}<span class="purelane-pimg pimg p-metal" role="img" aria-label="{{ product.title | escape }}"></span>
      {%- elsif title_clean contains 'wash' or title_clean contains 'descaler' -%}<span class="purelane-pimg pimg p-wm" role="img" aria-label="{{ product.title | escape }}"></span>
      {%- elsif title_clean contains 'floor' -%}<span class="purelane-pimg pimg p-floor" role="img" aria-label="{{ product.title | escape }}"></span>
      {%- elsif title_clean contains 'dish' -%}<span class="purelane-pimg pimg p-dish" role="img" aria-label="{{ product.title | escape }}"></span>
      {%- else -%}<span class="purelane-pimg pimg p-tap" role="img" aria-label="{{ product.title | escape }}"></span>{%- endif -%}
    {%- endif -%}
  </a>
  <h4 class="purelane-card-title" title="{{ product.title | escape }}"><a href="{{ product.url }}">{{ product.title }}</a></h4>
  {%- if rating != blank or reviews_count != blank -%}<div class="purelane-card-rate rate"><b>{% if rating != blank %}★ {{ rating }}{% endif %}</b>{% if rating != blank and reviews_count != blank %} · {% endif %}{% if reviews_count != blank %}{{ reviews_count }} reviews{% endif %}</div>{%- endif -%}
  <div class="purelane-card-pr pr"><strong>{{ product.price | money }}</strong>{%- if has_discount -%}<s>{{ product.compare_at_price | money }}</s><em>{{ savings }}% off</em>{%- endif -%}</div>
  {%- if product.available -%}
    {%- form 'product', product, class: 'purelane-card-form' -%}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button type="submit" name="add" class="purelane-btn btn purelane-btn-ghost btn-ghost purelane-btn-sm btn-sm purelane-card-btn">Add to cart</button>{%- endform -%}
  {%- else -%}<button type="button" class="purelane-btn btn purelane-btn-ghost btn-ghost purelane-btn-sm btn-sm purelane-card-btn" disabled>Sold Out</button>{%- endif -%}
</article>
