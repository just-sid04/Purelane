{% comment %}
  Purelane Reviews Section (Marquee Social Proof)
  Infinite auto-scrolling customer review marquee with aggregate rating stats and left/right gradient mask fading.
{% endcomment %}

<section class="purelane-sec sec purelane-revband revband" id="reviews" data-scene="1">
  <div class="purelane-wrap wrap">
    <div class="purelane-revhead revhead rv">
      <span class="purelane-kicker kicker">{{ section.settings.kicker | default: "That's what they said" | escape }}</span>
      <span class="purelane-agg agg">
        <span class="purelane-st st">★★★★★</span>
        <b>{{ section.settings.rating_score | default: '4.8' }}</b> from {{ section.settings.rating_count | default: '8,000+' }} reviews
      </span>
      <span class="purelane-agg agg">Loved by <b>{{ section.settings.homes_count | default: '12 lakh+' }}</b> homes</span>
    </div>
  </div>

  <div class="purelane-revrail revrail rv" aria-label="Customer reviews">
    <div class="purelane-revtrack revtrack">
      {%- if section.blocks.size > 0 -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {% render 'purelane-review-card',
              rating: block.settings.rating,
              title: block.settings.title,
              text: block.settings.text,
              author: block.settings.author,
              product_tag: block.settings.product_tag
            %}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..2) -%}
          {% render 'purelane-review-card', rating: 5, title: 'Works like a charm', text: 'Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.', author: 'Anita', product_tag: 'Laundry detergent' %}
          {% render 'purelane-review-card', rating: 5, title: 'Best dishwash ever', text: 'Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.', author: 'Priya', product_tag: 'Dishwash gel' %}
          {% render 'purelane-review-card', rating: 5, title: 'Great product, great packaging', text: 'Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.', author: 'Sunita', product_tag: 'Liquid handwash' %}
          {% render 'purelane-review-card', rating: 5, title: 'Dog friendly', text: 'We switched because chemical floor cleaners were setting off my dog\'s allergies. No reactions since.', author: 'Rohit S.', product_tag: 'Floor cleaner' %}
          {% render 'purelane-review-card', rating: 5, title: 'Sparkling taps again', text: 'Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.', author: 'Verified buyer', product_tag: 'Tap cleaner' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Header",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Average Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Total Review Count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes Served Count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Body",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Purchased Tag",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews"
    }
  ]
}
{% endschema %}
