{% comment %}
  Purelane Header Section
  Top announcement ticker marquee, glassmorphic floating header with scroll docking, and 7-dot vertical side progress rail.
  Also renders the global animated background scenes + water caustics engine.
{% endcomment %}

{%- render 'purelane-background-scenes' -%}

<!-- TOP ANNOUNCEMENT TICKER -->
<div class="purelane-ticker ticker" aria-hidden="true">
  <div class="purelane-track track">
    {%- if section.blocks.size > 0 -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'ticker_item' -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
    {%- endif -%}
  </div>
</div>

<!-- FLOATING HEADER -->
<header class="purelane-hdr" id="hdr">
  <div class="purelane-navpill navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="Purelane home">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">Purelane</span>
        <span class="n2">Clean, simply</span>
      </span>
    </a>

    <nav class="purelane-nav nav" aria-label="Main">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- endif -%}
    </nav>

    <div class="navtools">
      <button class="ico hide-s" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <a class="ico hide-s" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
      </a>
      <a class="ico" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        <span class="dot">{{ cart.item_count }}</span>
      </a>
      <button class="ico burger" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- SIDE PROGRESS RAIL INDICATORS -->
<nav class="purelane-rail rail" id="rail" aria-label="Section progress">
  <a href="#top" class="on" aria-label="Hero"></a>
  <a href="#ingredients" aria-label="Ingredients"></a>
  <a href="#how" aria-label="How it works"></a>
  <a href="#proof" aria-label="Proof"></a>
  <a href="#bundles" aria-label="Bundles"></a>
  <a href="#shop" aria-label="Shop"></a>
  <a href="#reviews" aria-label="Reviews"></a>
</nav>

{% schema %}
{
  "name": "Purelane Header & Ticker",
  "tag": "section",
  "class": "purelane-header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Header Navigation Menu"
    }
  ],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Announcement Text",
          "default": "Free shipping <b>on every bundle across India</b>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Header & Ticker",
      "blocks": [
        { "type": "ticker_item", "settings": { "text": "Free shipping <b>on every bundle across India</b>" } },
        { "type": "ticker_item", "settings": { "text": "100% plant-based <b>and non-toxic</b>" } },
        { "type": "ticker_item", "settings": { "text": "Loved by <b>30,000+ happy homes</b>" } },
        { "type": "ticker_item", "settings": { "text": "Buy 3 <b>at flat ₹499</b>" } }
      ]
    }
  ]
}
{% endschema %}
