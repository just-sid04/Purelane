{% comment %}
  Purelane Bundle Categories Section
  4 glassmorphic category cards: Kitchen, Bathroom, Laundry, Hard water.
{% endcomment %}

<section class="purelane-sec" id="categories" data-scene="4">
  <div class="purelane-wrap">
    <div class="purelane-panel-head rv">
      <span class="purelane-kicker">Bundle categories</span>
      <h2 class="purelane-d2" style="margin-top:12px">Find the right bundle for you</h2>
    </div>
    <div class="purelane-cats cats">
      <a class="purelane-glass cat rv" href="#combos">
        <span class="ph"><span class="purelane-pimg p-kitchen" role="img" aria-label="Kitchen cleaner"></span></span>
        <span class="txt"><h4>Kitchen bundle</h4><p>Grease, dishes &amp; more</p></span>
      </a>
      <a class="purelane-glass cat rv rv-d1" href="#combos">
        <span class="ph"><span class="purelane-pimg p-toilet" role="img" aria-label="Toilet cleaner"></span></span>
        <span class="txt"><h4>Bathroom bundle</h4><p>Deep clean &amp; disinfect</p></span>
      </a>
      <a class="purelane-glass cat rv rv-d2" href="#combos">
        <span class="ph"><span class="purelane-pimg p-laundry" role="img" aria-label="Laundry detergent"></span></span>
        <span class="txt"><h4>Laundry bundle</h4><p>Softer, fresher wash</p></span>
      </a>
      <a class="purelane-glass cat rv rv-d3" href="#combos">
        <span class="ph"><span class="purelane-pimg p-tap" role="img" aria-label="Tap cleaner"></span></span>
        <span class="txt"><h4>Hard water bundle</h4><p>Melt away limescale</p></span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "class": "purelane-categories-section",
  "presets": [
    {
      "name": "Purelane Categories"
    }
  ]
}
{% endschema %}
