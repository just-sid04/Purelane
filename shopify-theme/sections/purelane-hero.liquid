{% comment %}
  Purelane Hero Section
  Interactive hero banner with headline, subtext, CTAs, promise badges rail, and 3-slide multi-product stage.
{% endcomment %}

<section class="purelane-hero hero" id="top" data-scene="1">
  <div class="purelane-wrap purelane-hero-grid hero-grid">

    {%- if section.blocks.size > 0 -%}
      <div class="purelane-badges badges purelane-glass-2" aria-label="Product promises">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            <div class="purelane-badge badge" {{ block.shopify_attributes }}>
              <span class="purelane-bi bi">
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
                  {%- when 'prohibit' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {%- endcase -%}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="purelane-hero-copy hero-copy">
      <h1 class="purelane-d1 d1 rv in">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          Clean<br>That<br><span class="purelane-lime lime">Lasts</span>
        {%- endif -%}
      </h1>

      <div class="purelane-rule rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>

      <p class="purelane-lede lede rv rv-d2">
        {{ section.settings.subheading | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.' }}
      </p>

      <div class="purelane-hero-cta hero-cta rv rv-d3">
        {%- if section.settings.primary_cta_label != blank -%}
          <a class="purelane-btn btn purelane-btn-primary btn-primary" href="{{ section.settings.primary_cta_url | default: '#shop' }}">
            {{ section.settings.primary_cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a class="purelane-btn btn purelane-btn-ghost btn-ghost" href="{{ section.settings.secondary_cta_url | default: '#how' }}">
            {{ section.settings.secondary_cta_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="purelane-badgestrip badgestrip rv rv-d4">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <div class="purelane-glass-2 glass-2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
                {{ block.settings.label }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Product Stage Carousel -->
    <div class="purelane-hero-prod hero-prod" id="heroProd">
      <div class="purelane-hstage hstage" id="hstage">
        {%- assign slide_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}
            {%- assign slide_count = slide_count | plus: 1 -%}
            <div class="purelane-hslide hslide hs{{ slide_count }}{% if slide_count == 1 %} on{% endif %}" data-n="{{ slide_count }}" {{ block.shopify_attributes }}>
              <!-- Product 1 -->
              {%- if block.settings.product_1 != blank -%}
                <img src="{{ block.settings.product_1.featured_image | image_url: width: 600 }}" alt="{{ block.settings.product_1.title | escape }}" class="purelane-hp hp a d1" loading="eager" width="600" height="600">
              {%- elsif block.settings.pimg_class_1 != blank -%}
                <span class="purelane-hp hp {{ block.settings.pimg_class_1 }} a d1" role="img"></span>
              {%- else -%}
                <span class="purelane-hp hp p-kbtl a d1" role="img"></span>
              {%- endif -%}

              <!-- Product 2 (for multi-product slides) -->
              {%- if block.settings.product_2 != blank -%}
                <img src="{{ block.settings.product_2.featured_image | image_url: width: 600 }}" alt="{{ block.settings.product_2.title | escape }}" class="purelane-hp hp b d2" loading="eager" width="600" height="600">
              {%- elsif block.settings.pimg_class_2 != blank -%}
                <span class="purelane-hp hp {{ block.settings.pimg_class_2 }} b d2" role="img"></span>
              {%- endif -%}

              <!-- Product 3 (for 3-product slides) -->
              {%- if block.settings.product_3 != blank -%}
                <img src="{{ block.settings.product_3.featured_image | image_url: width: 600 }}" alt="{{ block.settings.product_3.title | escape }}" class="purelane-hp hp c d3" loading="eager" width="600" height="600">
              {%- elsif block.settings.pimg_class_3 != blank -%}
                <span class="purelane-hp hp {{ block.settings.pimg_class_3 }} c d3" role="img"></span>
              {%- endif -%}

              <div class="purelane-glass-2 glass-2 purelane-ptag ptag">
                <span class="lbl">{{ block.settings.slide_label | default: 'Single bottle' }}</span>
                <span class="val">
                  <strong>{{ block.settings.price | default: '₹200' }}</strong>
                  {%- if block.settings.compare_price != blank -%}
                    <s>{{ block.settings.compare_price }}</s>
                  {%- endif -%}
                </span>
                {%- if block.settings.cut_tag != blank -%}
                  <span class="cut">{{ block.settings.cut_tag }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if slide_count == 0 -%}
          <!-- Default Fallback Slides matching purelane-homepage.html prototype -->
          <div class="purelane-hslide hslide hs1 on" data-n="1">
            <span class="purelane-hp hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="purelane-glass-2 glass-2 purelane-ptag ptag">
              <span class="lbl">Single bottle</span>
              <span class="val"><strong>₹200</strong><s>₹299</s></span>
              <span class="cut">33% off</span>
            </div>
          </div>
          <div class="purelane-hslide hslide hs2" data-n="2">
            <span class="purelane-hp hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner spray bottle"></span>
            <span class="purelane-hp hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="purelane-glass-2 glass-2 purelane-ptag ptag">
              <span class="lbl">Any 2 products</span>
              <span class="val"><strong>₹349</strong><s>₹598</s></span>
              <span class="cut">Save ₹249</span>
            </div>
          </div>
          <div class="purelane-hslide hslide hs3" data-n="3">
            <span class="purelane-hp hp p-tbtl a d1" role="img" aria-label="Purelane tap cleaner spray bottle"></span>
            <span class="purelane-hp hp p-mbtl b d2" role="img" aria-label="Purelane brass cleaner pump bottle"></span>
            <span class="purelane-hp hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
            <div class="purelane-glass-2 glass-2 purelane-ptag ptag">
              <span class="lbl">Any 3 products</span>
              <span class="val"><strong>₹499</strong><s>₹897</s></span>
              <span class="cut">Save ₹398</span>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="purelane-hdots hdots" id="hdots">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" class="" aria-label="Show 2 products"></button>
        <button type="button" class="" aria-label="Show 3 products"></button>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "purelane-hero-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Clean<br>That<br><span class=\"purelane-lime lime\">Lasts</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary Button Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary Button Link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Plant Leaf" },
            { "value": "shield", "label": "Safety Shield" },
            { "value": "prohibit", "label": "Zero Chemicals" }
          ],
          "default": "leaf"
        },
        {
          "type": "inline_richtext",
          "id": "label",
          "label": "Badge Label",
          "default": "Plant<br>powered"
        }
      ]
    },
    {
      "type": "slide",
      "name": "Stage Slide",
      "settings": [
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1 Showcase"
        },
        {
          "type": "text",
          "id": "pimg_class_1",
          "label": "Product 1 CSS Vector Class (if no product image)",
          "default": "p-kbtl"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2 Showcase (Optional)"
        },
        {
          "type": "text",
          "id": "pimg_class_2",
          "label": "Product 2 CSS Vector Class"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3 Showcase (Optional)"
        },
        {
          "type": "text",
          "id": "pimg_class_3",
          "label": "Product 3 CSS Vector Class"
        },
        {
          "type": "text",
          "id": "slide_label",
          "label": "Tag Label",
          "default": "Single bottle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Display Price",
          "default": "₹200"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹299"
        },
        {
          "type": "text",
          "id": "cut_tag",
          "label": "Discount Tag",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "Plant<br>powered" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "Safe for<br>kids & pets" } },
        { "type": "badge", "settings": { "icon": "prohibit", "label": "Zero harsh<br>chemicals" } },
        { "type": "slide", "settings": { "pimg_class_1": "p-kbtl", "slide_label": "Single bottle", "price": "₹200", "compare_price": "₹299", "cut_tag": "33% off" } },
        { "type": "slide", "settings": { "pimg_class_1": "p-tbtl", "pimg_class_2": "p-kbtl", "slide_label": "Any 2 products", "price": "₹349", "compare_price": "₹598", "cut_tag": "Save ₹249" } },
        { "type": "slide", "settings": { "pimg_class_1": "p-tbtl", "pimg_class_2": "p-mbtl", "pimg_class_3": "p-kbtl", "slide_label": "Any 3 products", "price": "₹499", "compare_price": "₹897", "cut_tag": "Save ₹398" } }
      ]
    }
  ]
}
{% endschema %}
