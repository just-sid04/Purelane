<section class="purelane-hero hero" id="top" data-scene="1">
  <div class="purelane-wrap purelane-hero-grid hero-grid">
    {%- assign badge_count = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'badge' -%}{%- assign badge_count = badge_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if badge_count > 0 -%}<div class="purelane-badges badges purelane-glass-2" aria-label="Product promises">{%- for block in section.blocks -%}{%- if block.type == 'badge' -%}<div class="purelane-badge badge" {{ block.shopify_attributes }}><span class="purelane-bi bi" aria-hidden="true">{%- case block.settings.icon -%}{%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>{%- when 'prohibit' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>{%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>{%- endcase -%}</span><span>{{ block.settings.label | escape }}</span></div>{%- endif -%}{%- endfor -%}</div>{%- endif -%}
    <div class="purelane-hero-copy hero-copy"><h1 class="purelane-d1 d1 rv in">{{ section.settings.heading | default: 'Clean That Lasts' | escape }}</h1><div class="purelane-rule rule rv rv-d1"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div><p class="purelane-lede lede rv rv-d2">{{ section.settings.subheading | default: 'Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it.' | escape }}</p><div class="purelane-hero-cta hero-cta rv rv-d3">{%- if section.settings.primary_cta_label != blank -%}<a class="purelane-btn btn purelane-btn-primary btn-primary" href="{{ section.settings.primary_cta_url | default: '#shop' }}">{{ section.settings.primary_cta_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>{%- endif -%}{%- if section.settings.secondary_cta_label != blank -%}<a class="purelane-btn btn purelane-btn-ghost btn-ghost" href="{{ section.settings.secondary_cta_url | default: '#how' }}">{{ section.settings.secondary_cta_label | escape }}</a>{%- endif -%}</div></div>
    <div class="purelane-hero-prod hero-prod" id="heroProd"><div class="purelane-hstage hstage" id="hstage">{%- assign slide_index = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'slide' -%}{%- assign slide_index = slide_index | plus: 1 -%}<div class="purelane-hslide hslide hs{{ block.settings.products.size }}{% if slide_index == 1 %} on{% endif %}" data-n="{{ slide_index }}" {{ block.shopify_attributes }}>{%- assign total_price = 0 -%}{%- for product in block.settings.products -%}{%- assign total_price = total_price | plus: product.price_min -%}{%- endfor -%}{%- for product in block.settings.products limit: 3 -%}{%- assign product_class = 'a' -%}{%- if forloop.index == 2 -%}{%- assign product_class = 'b' -%}{%- elsif forloop.index == 3 -%}{%- assign product_class = 'c' -%}{%- endif -%}{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'eager', widths: '320,450,600', sizes: '(max-width: 900px) 88vw, 50vw', alt: product.featured_image.alt | default: product.title, class: 'purelane-hp hp ' | append: product_class }}{%- else -%}<span class="purelane-hp hp p-tap {{ product_class }}" role="img" aria-label="{{ product.title | escape }}"></span>{%- endif -%}{%- endfor -%}{%- assign discount_factor = 100 | minus: block.settings.discount_percent -%}{%- assign bundle_price = total_price | times: discount_factor | divided_by: 100 -%}{%- assign saving = total_price | minus: bundle_price -%}<div class="purelane-glass-2 glass-2 purelane-ptag ptag"><span class="lbl">{{ block.settings.slide_label | default: block.settings.products.size | append: ' products' | escape }}</span><span class="val"><strong>{{ bundle_price | money }}</strong>{% if total_price > bundle_price %}<s>{{ total_price | money }}</s>{% endif %}</span>{%- if saving > 0 -%}<span class="cut">Save {{ saving | money }}</span>{%- endif -%}</div></div>{%- endif -%}{%- endfor -%}</div><div class="purelane-hdots hdots" id="hdots" data-hero-dots>{%- assign dot_index = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'slide' -%}{%- assign dot_index = dot_index | plus: 1 -%}<button type="button" class="{% if dot_index == 1 %}on{% endif %}" aria-label="Show slide {{ dot_index }}" aria-current="{% if dot_index == 1 %}true{% else %}false{% endif %}"></button>{%- endif -%}{%- endfor -%}</div></div>
  </div>
</section>
{% schema %}
{"name":"Purelane Hero","tag":"section","class":"purelane-hero-section","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"Clean That Lasts"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."},{"type":"text","id":"primary_cta_label","label":"Primary Button Label","default":"Shop now"},{"type":"url","id":"primary_cta_url","label":"Primary Button Link"},{"type":"text","id":"secondary_cta_label","label":"Secondary Button Label","default":"How it works"},{"type":"url","id":"secondary_cta_url","label":"Secondary Button Link"}],"blocks":[{"type":"badge","name":"Promise Badge","limit":3,"settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"leaf","label":"Plant Leaf"},{"value":"shield","label":"Safety Shield"},{"value":"prohibit","label":"Zero Harsh Chemicals"}],"default":"leaf"},{"type":"text","id":"label","label":"Badge Label","default":"Plant powered"}]},{"type":"slide","name":"Stage Slide","limit":3,"settings":[{"type":"product_list","id":"products","label":"Products","limit":3},{"type":"range","id":"discount_percent","label":"Bundle saving %","min":0,"max":50,"step":1,"default":0},{"type":"text","id":"slide_label","label":"Tag Label","default":"Single bottle"}]}],"presets":[{"name":"Purelane Hero"}]}
{% endschema %}