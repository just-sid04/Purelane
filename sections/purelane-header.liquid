```liquid
{% comment %}
  Purelane Header Section
  Top announcement ticker, floating glass header, main navigation,
  and 7-dot vertical section progress rail.
{% endcomment %}

{%- render 'purelane-background-scenes' -%}

<!-- TOP ANNOUNCEMENT TICKER -->
<div class="purelane-ticker ticker" aria-hidden="true">
  <div class="purelane-track track">
    {%- if section.blocks.size > 0 -%}
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'ticker_item' -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
    {%- endif -%}
  </div>
</div>

<!-- FLOATING HEADER -->
<header class="purelane-hdr" id="hdr">
  <div class="purelane-navpill navpill glass">

    <!-- BRAND -->
    <a
      class="brand"
      href="{{ routes.root_url }}"
      aria-label="Purelane home"
    >
      <span class="mark">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color:#b8701c"
          aria-hidden="true"
        >
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>

      <span class="txt">
        <span class="n1">Purelane</span>
        <span class="n2">Clean, simply</span>
      </span>
    </a>

    <!-- MAIN NAVIGATION -->
    <nav class="purelane-nav nav" aria-label="Main navigation">

      <a href="{{ routes.root_url }}#top">
        Home
      </a>

      <a href="{{ routes.root_url }}#ingredients">
        Ingredients
      </a>

      <a href="{{ routes.root_url }}#how">
        How it works
      </a>

      <a href="{{ routes.root_url }}#shop">
        Shop
      </a>

      <a href="{{ routes.root_url }}#bundles">
        Bundles
      </a>

    </nav>

    <!-- NAVIGATION TOOLS -->
    <div class="navtools">

      <!-- SEARCH -->
      <button
        type="button"
        class="ico hide-s"
        aria-label="Search"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-3.5-3.5"/>
        </svg>
      </button>

      <!-- ACCOUNT -->
      <a
        class="ico hide-s"
        href="{{ routes.account_url }}"
        aria-label="Account"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="3.6"/>
          <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
        </svg>
      </a>

      <!-- CART -->
      <a
        class="ico"
        href="{{ routes.cart_url }}"
        aria-label="Cart, {{ cart.item_count }} items"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
          <circle cx="10" cy="20.5" r="1.1"/>
          <circle cx="17.5" cy="20.5" r="1.1"/>
        </svg>

        <span class="dot">
          {{ cart.item_count }}
        </span>
      </a>

      <!-- MOBILE MENU -->
      <button
        type="button"
        class="ico burger"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 8h16M4 16h16"/>
        </svg>
      </button>

    </div>
  </div>
</header>

<!-- SIDE PROGRESS RAIL -->
<nav
  class="purelane-rail rail"
  id="rail"
  aria-label="Section progress"
>
  <a href="{{ routes.root_url }}#top" class="on" aria-label="Hero"></a>
  <a href="{{ routes.root_url }}#ingredients" aria-label="Ingredients"></a>
  <a href="{{ routes.root_url }}#how" aria-label="How it works"></a>
  <a href="{{ routes.root_url }}#proof" aria-label="Proof"></a>
  <a href="{{ routes.root_url }}#bundles" aria-label="Bundles"></a>
  <a href="{{ routes.root_url }}#shop" aria-label="Shop"></a>
  <a href="{{ routes.root_url }}#reviews" aria-label="Reviews"></a>
</nav>

{% schema %}
{
  "name": "Purelane Header & Ticker",
  "tag": "section",
  "class": "purelane-header-section",
  "settings": [],
  "blocks": [
    {
      "type": "ticker_item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Free shipping on every bundle across India"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Header & Ticker",
      "blocks": [
        {
          "type": "ticker_item",
          "settings": {
            "text": "Free shipping on every bundle across India"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "100% plant-based and non-toxic"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "Loved by 30,000+ happy homes"
          }
        },
        {
          "type": "ticker_item",
          "settings": {
            "text": "Buy 3 at flat ₹499"
          }
        }
      ]
    }
  ]
}
{% endschema %}
```
