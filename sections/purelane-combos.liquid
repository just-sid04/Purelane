{% comment %}
  Purelane Best Selling Combos Section
  Horizontal snap-scrolling rail displaying pre-built bundle boxes with bottle stacks & savings tags.
{% endcomment %}

<section class="purelane-sec" id="combos" data-scene="3">
  <div class="purelane-wrap">
    <div class="purelane-panel-head rv">
      <span class="purelane-kicker">{{ section.settings.kicker | default: 'Pre-built to save you money' | escape }}</span>
      <h2 class="purelane-d2" style="margin-top:12px">{{ section.settings.title | default: 'Best selling combos' | escape }}</h2>
      <div class="purelane-rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="purelane-lede" style="margin:14px auto 0">{{ section.settings.subheading | default: 'Swipe through the boxes people order most. Each one is already priced below buying the same products on their own.' | escape }}</p>
    </div>

    <div class="purelane-comborail comborail rv">
      <!-- Combo 1: Kitchen Essentials -->
      <article class="purelane-glass combo">
        <div class="tray">
          <span class="save">You save ₹398</span>
          <span class="flag">Most popular</span>
          <div class="stack">
            <span class="it"><span class="purelane-pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner"></span><span>Cuts grease instantly</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-dish" role="img" aria-label="Organic dishwash liquid gel"></span><span>Squeaky clean dishes</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span>
          </div>
        </div>
        <div class="body">
          <h3>Kitchen essentials</h3>
          <div class="cnt">3 products</div>
          <p class="inc">Includes: Foaming Kitchen Cleaner, Dishwash Gel &amp; Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately.</p>
          <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
          <div class="fine">Inclusive of all taxes &middot; COD available</div>
          <a class="purelane-btn purelane-btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        </div>
      </article>

      <!-- Combo 2: Laundry Care Bundle -->
      <article class="purelane-glass combo">
        <div class="tray">
          <span class="save">You save ₹448</span>
          <div class="stack">
            <span class="it"><span class="purelane-pimg p-laundry" role="img" aria-label="Non-toxic laundry detergent"></span><span>Removes tough stains &amp; odour</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span><span>Softens &amp; freshens every wash</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-wm" role="img" aria-label="Washing machine descaler"></span><span>Deep-cleans your machine</span></span>
          </div>
        </div>
        <div class="body">
          <h3>Laundry care bundle</h3>
          <div class="cnt">3 products</div>
          <p class="inc">Includes: Laundry Detergent, Fabric Conditioner &amp; Machine Cleaner Powder. Softer, fresher wash, all in one box.</p>
          <div class="prow"><strong>₹499</strong><s>₹947</s><em>Save ₹448</em></div>
          <div class="fine">Inclusive of all taxes &middot; COD available</div>
          <a class="purelane-btn purelane-btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        </div>
      </article>

      <!-- Combo 3: Complete Home Bundle (Hero Combo) -->
      <article class="purelane-glass combo hero-combo">
        <div class="tray">
          <span class="save">Biggest saving</span>
          <span class="flag">Best value</span>
          <div class="stack">
            <span class="it"><span class="purelane-pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner"></span><span>Cuts grease instantly</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-floor" role="img" aria-label="Natural herbal floor cleaner"></span><span>Kills 99.9% germs</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-handwash" role="img" aria-label="Hydrating liquid handwash"></span><span>Gentle hydration for hands</span></span>
          </div>
        </div>
        <div class="body">
          <h3>Complete home bundle</h3>
          <div class="cnt">5 products</div>
          <p class="inc">Includes: Kitchen Cleaner, Laundry Detergent, Floor Cleaner, Toilet Cleaner &amp; Handwash. Our biggest saving box.</p>
          <div class="prow"><strong>₹799</strong><s>₹1,495</s><em>Save ₹696</em></div>
          <div class="fine">Inclusive of all taxes &middot; COD available</div>
          <a class="purelane-btn purelane-btn-primary" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        </div>
      </article>

      <!-- Combo 4: Bathroom Deep Clean -->
      <article class="purelane-glass combo">
        <div class="tray">
          <span class="save">You save ₹398</span>
          <div class="stack">
            <span class="it"><span class="purelane-pimg p-toilet" role="img" aria-label="Non-toxic toilet cleaner"></span><span>Kills 99.9% germs</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-eraser" role="img" aria-label="Magic eraser"></span><span>Scrubs away soap scum</span></span>
          </div>
        </div>
        <div class="body">
          <h3>Bathroom deep clean</h3>
          <div class="cnt">3 products</div>
          <p class="inc">Includes: Toilet Cleaner, Tap Cleaner &amp; Magic Eraser. A complete bathroom refresh in one box.</p>
          <div class="prow"><strong>₹499</strong><s>₹897</s><em>Save ₹398</em></div>
          <div class="fine">Inclusive of all taxes &middot; COD available</div>
          <a class="purelane-btn purelane-btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        </div>
      </article>

      <!-- Combo 5: Hard Water Solution Kit -->
      <article class="purelane-glass combo">
        <div class="tray">
          <span class="save">You save ₹249</span>
          <div class="stack">
            <span class="it"><span class="purelane-pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover"></span><span>Melts hard water stains</span></span>
            <span class="plus" aria-hidden="true">+</span>
            <span class="it"><span class="purelane-pimg p-toilet" role="img" aria-label="Non-toxic toilet cleaner"></span><span>Fights limescale in the bowl</span></span>
          </div>
        </div>
        <div class="body">
          <h3>Hard water solution kit</h3>
          <div class="cnt">2 products</div>
          <p class="inc">Includes: Tap Cleaner &amp; Toilet Cleaner. A quick, focused fix for hard water stains across the home.</p>
          <div class="prow"><strong>₹349</strong><s>₹598</s><em>Save ₹249</em></div>
          <div class="fine">Inclusive of all taxes &middot; COD available</div>
          <a class="purelane-btn purelane-btn-ghost" href="#bundles">Shop bundle <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a>
        </div>
      </article>
    </div>

    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      Swipe for more combos
    </div>
    <p class="railnote">Tapping &quot;Shop bundle&quot; opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos"
    }
  ]
}
{% endschema %}
