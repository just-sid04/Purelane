<section class="purelane-sec" id="whybundles" data-scene="4">
  <div class="purelane-wrap"><div class="purelane-glass purelane-sec-pad rv"><div class="purelane-panel-head"><span class="purelane-kicker">{{ section.settings.kicker | default: 'The smarter way to shop' | escape }}</span><h2 class="purelane-d2" style="margin-top:12px">{{ section.settings.title | default: 'Why bundles beat buying single' | escape }}</h2></div><div class="purelane-wb wb">
    {%- for block in section.blocks -%}<div class="wb-i" {{ block.shopify_attributes }}><span class="ci" aria-hidden="true">{{ block.settings.icon_svg }}</span><h4>{{ block.settings.title | escape }}</h4><p>{{ block.settings.description | escape }}</p></div>{%- else -%}<p class="purelane-body-s">Add benefit blocks in the Theme Editor.</p>{%- endfor -%}
  </div></div></div>
</section>
{% schema %}
{"name":"Purelane Why Bundles","tag":"section","class":"purelane-whybundles-section","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"The smarter way to shop"},{"type":"text","id":"title","label":"Heading","default":"Why bundles beat buying single"}],"blocks":[{"type":"benefit","name":"Bundle Benefit","settings":[{"type":"html","id":"icon_svg","label":"Icon SVG","default":"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><circle cx=\"12\" cy=\"12\" r=\"8\"/></svg>"},{"type":"text","id":"title","label":"Benefit Title","default":"Save more"},{"type":"textarea","id":"description","label":"Benefit Description","default":"Versus buying the same products separately"}]}],"presets":[{"name":"Purelane Why Bundles"}]}
{% endschema %}