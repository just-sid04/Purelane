<section class="purelane-sec sec" id="cart"><div class="purelane-wrap wrap"><div class="purelane-panel-head panel-head"><span class="purelane-kicker kicker">Your cart</span><h1 class="purelane-d2 d2" style="margin-top:12px">Review your order</h1></div>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" id="PurelaneCartForm"><div class="purelane-glass glass" style="padding:20px">{% for item in cart.items %}<div style="display:grid;grid-template-columns:80px 1fr auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid rgba(236,230,247,.12)">{% if item.image %}{% assign cart_image = item.image | image_url: width: 160 %}<img src="{{ cart_image }}" alt="{{ item.title | escape }}" loading="lazy" width="80" height="80" style="width:80px;height:80px;object-fit:contain">{% endif %}<div><a href="{{ item.url }}" class="purelane-d4">{{ item.product.title | escape }}</a><div class="purelane-body-s">{{ item.final_line_price | money }}</div></div><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}" style="width:70px;height:40px;border-radius:10px;padding:0 8px"></div>{% endfor %}<div style="display:flex;justify-content:space-between;align-items:center;margin-top:20px"><strong class="purelane-d3">Total</strong><strong class="purelane-d3">{{ cart.total_price | money }}</strong></div><div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px"><button class="purelane-btn purelane-btn-ghost btn-ghost" type="submit" name="update">Update cart</button><button class="purelane-btn purelane-btn-primary btn-primary" type="submit" name="checkout">Checkout</button></div></div></form>{% else %}<div class="purelane-glass glass" style="padding:32px;text-align:center"><p class="purelane-body-s">Your cart is empty.</p><a class="purelane-btn purelane-btn-primary btn-primary" href="{{ routes.root_url }}#shop" style="margin-top:16px">Continue shopping</a></div>{% endif %}</div></section>{% schema %}{"name":"Purelane Cart","tag":"section","class":"purelane-cart-section","settings":[],"presets":[{"name":"Purelane Cart"}]}{% endschema %}