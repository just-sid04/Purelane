<section class="purelane-sec sec" id="ingredients" data-scene="2">
  <div class="purelane-wrap wrap"><div class="purelane-glass glass purelane-sec-pad sec-pad rv"><div class="purelane-panel-head panel-head"><h2 class="purelane-d2 d2">{{ section.settings.title | default: 'Sourced from nature' | escape }}</h2><div class="purelane-rule rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div></div><div class="purelane-ing ing">{%- for block in section.blocks -%}{% render 'purelane-ingredient-card', title: block.settings.title, text: block.settings.text, image: block.settings.image %}{%- endfor -%}</div></div></div>
</section>
<section class="purelane-sec sec" id="proof" data-scene="3"><div class="purelane-wrap wrap"><div class="purelane-glass glass purelane-sec-pad sec-pad rv"><div class="purelane-proof proof"><div class="proof-l"><span class="purelane-kicker kicker">{{ section.settings.proof_kicker | default: 'Why it works' | escape }}</span><h2 class="purelane-d2 d2" style="margin-top:12px">{{ section.settings.proof_title | default: 'Tough on grime. Gentle on everything else.' | escape }}</h2><p class="purelane-body-s body-s" style="max-width:40ch">{{ section.settings.proof_text | default: 'Every formula is built on plant-derived cleansers and essential oils.' | escape }}</p><a class="purelane-btn btn purelane-btn-primary btn-primary" href="{{ section.settings.proof_url | default: '#ingredients' }}">{{ section.settings.proof_button | default: 'See the ingredient list' | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></a></div><div class="purelane-glass-2 glass-2 purelane-rot rot" id="rot" aria-hidden="true"><div class="frame">{%- assign rot_products = section.settings.rotator_products -%}{%- for product in rot_products limit: 6 -%}<img class="purelane-pimg pimg{% if forloop.first %} on{% endif %}" src="{{ product.featured_image | image_url: width: 320 }}" alt="{{ product.title | escape }}" width="320" height="320" loading="lazy" decoding="async" data-name="{{ product.title | escape }}" data-note="{{ product.description | strip_html | truncate: 48 | escape }}">{%- endfor -%}</div><div class="cap"><b>Product</b><span>Plant-derived cleaning</span></div><div class="dots">{%- for product in rot_products limit: 6 -%}<i class="{% if forloop.first %}on{% endif %}"></i>{%- endfor -%}</div></div></div><div class="purelane-glass-2 glass-2 stats proof-stats" style="margin-top:20px"><div class="stat"><div class="ring">99.9%</div><h5>{{ section.settings.stat1_title | default: 'Germ kill' | escape }}</h5><p>{{ section.settings.stat1_text | default: 'Tested against germs and bacteria' | escape }}</p></div><div class="stat"><div class="ring">0%</div><h5>{{ section.settings.stat2_title | default: 'Sulphates' | escape }}</h5><p>{{ section.settings.stat2_text | default: 'No SLS, chlorine or parabens' | escape }}</p></div><div class="stat"><div class="ring">100%</div><h5>{{ section.settings.stat3_title | default: 'Plant based' | escape }}</h5><p>{{ section.settings.stat3_text | default: 'Cleansers derived from plants' | escape }}</p></div><div class="stat"><div class="ring">{{ section.settings.rating | default: '4.8' | escape }}</div><h5>{{ section.settings.stat4_title | default: 'Rated' | escape }}</h5><p>{{ section.settings.stat4_text | default: 'Across verified reviews' | escape }}</p></div></div></div></div></section>
{% schema %}
{"name":"Purelane Ingredients","tag":"section","class":"purelane-ingredients-section","settings":[{"type":"text","id":"title","label":"Section Title","default":"Sourced from nature"},{"type":"text","id":"proof_kicker","label":"Proof Kicker","default":"Why it works"},{"type":"text","id":"proof_title","label":"Proof Heading","default":"Tough on grime. Gentle on everything else."},{"type":"textarea","id":"proof_text","label":"Proof Copy","default":"Every formula is built on plant-derived cleansers and essential oils."},{"type":"text","id":"proof_button","label":"Proof Button","default":"See the ingredient list"},{"type":"url","id":"proof_url","label":"Proof Button Link"},{"type":"product_list","id":"rotator_products","label":"Proof Product Rotator","limit":6},{"type":"text","id":"stat1_title","label":"Stat 1 Title","default":"Germ kill"},{"type":"text","id":"stat1_text","label":"Stat 1 Text","default":"Tested against germs and bacteria"},{"type":"text","id":"stat2_title","label":"Stat 2 Title","default":"Sulphates"},{"type":"text","id":"stat2_text","label":"Stat 2 Text","default":"No SLS, chlorine or parabens"},{"type":"text","id":"stat3_title","label":"Stat 3 Title","default":"Plant based"},{"type":"text","id":"stat3_text","label":"Stat 3 Text","default":"Cleansers derived from plants"},{"type":"text","id":"rating","label":"Rating Stat","default":"4.8"},{"type":"text","id":"stat4_title","label":"Stat 4 Title","default":"Rated"},{"type":"text","id":"stat4_text","label":"Stat 4 Text","default":"Across verified reviews"}],"blocks":[{"type":"ingredient","name":"Ingredient Item","settings":[{"type":"text","id":"title","label":"Ingredient Name","default":"Coconut"},{"type":"textarea","id":"text","label":"Ingredient Benefit Description","default":"Plant-derived cleansers that lift grease"},{"type":"image_picker","id":"image","label":"Custom Icon Image"}]}],"presets":[{"name":"Purelane Ingredients & Proof"}]}
{% endschema %}