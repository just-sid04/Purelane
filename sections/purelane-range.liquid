{% comment %}
  Purelane Full Range Section
  Displays all 10 product bottles lined up on a single glass shelf with swipe cue.
{% endcomment %}

<section class="purelane-sec" id="range" data-scene="3">
  <div class="purelane-wrap">
    <div class="purelane-glass range rv">
      <div class="range-head">
        <div>
          <span class="purelane-kicker">The full range</span>
          <h2 class="purelane-d2" style="margin-top:10px">Every room, one shelf</h2>
        </div>
        <p class="purelane-body-s" style="max-width:34ch;margin-bottom:4px">Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink.</p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          <span class="purelane-pimg p-floor" role="img" aria-label="Natural herbal floor cleaner"></span>
          <span class="purelane-pimg p-tap" role="img" aria-label="Tap cleaner and limescale remover"></span>
          <span class="purelane-pimg p-kitchen" role="img" aria-label="Foaming kitchen cleaner"></span>
          <span class="purelane-pimg p-toilet" role="img" aria-label="Non-toxic toilet cleaner"></span>
          <span class="purelane-pimg p-laundry" role="img" aria-label="Natural laundry detergent"></span>
          <span class="purelane-pimg p-dish" role="img" aria-label="Organic dishwash liquid gel"></span>
          <span class="purelane-pimg p-metal" role="img" aria-label="Copper, bronze and brass cleaner"></span>
          <span class="purelane-pimg p-wm" role="img" aria-label="Washing machine cleaner descaler"></span>
          <span class="purelane-pimg p-handwash" role="img" aria-label="Gentle hydrating liquid handwash"></span>
          <span class="purelane-pimg p-eraser" role="img" aria-label="Magic eraser"></span>
        </div>
      </div>
      <p class="striphint">Swipe to see the full shelf</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-range-section",
  "presets": [
    {
      "name": "Purelane Full Range"
    }
  ]
}
{% endschema %}
