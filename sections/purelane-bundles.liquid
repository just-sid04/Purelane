{% comment %} Purelane Bundles Section {% endcomment %}
<section class="purelane-sec sec" id="bundles" data-scene="3"><div class="purelane-wrap wrap"><div class="purelane-glass glass purelane-sec-pad sec-pad rv" style="margin-bottom:16px"><div class="purelane-panel-head panel-head" style="margin-bottom:0"><span class="purelane-kicker kicker">{{ section.settings.kicker | default: 'Build your bundle' | escape }}</span><h2 class="purelane-d2 d2" style="margin-top:12px">{{ section.settings.title | default: 'One box. Every room.' | escape }}</h2><p class="purelane-lede lede" style="margin:0 auto">{{ section.settings.subheading | default: 'Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.' | escape }}</p></div></div><div class="purelane-tiers tiers">{%- if section.blocks.size > 0 -%}{%- for block in section.blocks -%}<article class="purelane-glass glass purelane-tier tier{% if block.settings.is_featured %} best{% endif %} rv" {{ block.shopify_attributes }}>{%- if block.settings.tag != blank -%}<span class="purelane-tag tag">{{ block.settings.tag | escape }}</span>{%- endif -%}<div class="purelane-tierpix tierpix{% if block.settings.product_count == '5' %} five{% endif %}" aria-hidden="true">{%- if block.settings.product_count == '2' -%}<span class="purelane-pimg pimg p-combo2" role="img"></span>{%- elsif block.settings.product_count == '5' -%}<span class="purelane-pimg pimg p-kitchen" role="img"></span><span class="purelane-pimg pimg p-tap" role="img"></span><span class="purelane-pimg pimg p-floor" role="img"></span><span class="purelane-pimg pimg p-toilet" role="img"></span><span class="purelane-pimg pimg p-laundry" role="img"></span>{%- else -%}<span class="purelane-pimg pimg p-kitchen" role="img"></span><span class="purelane-pimg pimg p-tap" role="img"></span><span class="purelane-pimg pimg p-dish" role="img"></span>{%- endif -%}</div><div class="purelane-qty qty">{{ block.settings.product_count | default: '3' }}<small>Products</small></div><div class="purelane-price price">{{ block.settings.price | default: '₹499' }}{%- if block.settings.compare_price != blank -%}<s>{{ block.settings.compare_price }}</s>{%- endif -%}</div>{%- if block.settings.unit_note != blank -%}<p class="purelane-body-s body-s" style="font-size:12px">{{ block.settings.unit_note | escape }}</p>{%- endif -%}<ul>{%- if block.settings.feature_1 != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 | escape }}</li>{%- endif -%}{%- if block.settings.feature_2 != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 | escape }}</li>{%- endif -%}{%- if block.settings.feature_3 != blank -%}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 | escape }}</li>{%- endif -%}</ul><a class="purelane-btn btn {% if block.settings.is_featured %}purelane-btn-primary btn-primary{% else %}purelane-btn-ghost btn-ghost{% endif %}" href="{{ block.settings.btn_url | default: '#shop' }}">{{ block.settings.btn_label | default: 'Build this box' }}{% if block.settings.is_featured %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>{% endif %}</a></article>{%- endfor -%}{%- else -%}<article class="purelane-glass glass purelane-tier tier rv"><span class="purelane-tag tag">Starter</span><div class="purelane-tierpix tierpix" aria-hidden="true"><span class="purelane-pimg pimg p-combo2" role="img"></span></div><div class="purelane-qty qty">2<small>Products</small></div><div class="purelane-price price">₹349 <s>₹598</s></div><p class="purelane-body-s body-s" style="font-size:12px">Flat ₹174 per product</p><ul><li>Pick any two products</li><li>Free shipping across India</li></ul><a class="purelane-btn btn purelane-btn-ghost btn-ghost" href="#shop">Build this box</a></article><article class="purelane-glass glass purelane-tier tier best rv"><span class="purelane-tag tag">Most popular</span><div class="purelane-tierpix tierpix" aria-hidden="true"><span class="purelane-pimg pimg p-kitchen" role="img"></span><span class="purelane-pimg pimg p-tap" role="img"></span><span class="purelane-pimg pimg p-dish" role="img"></span></div><div class="purelane-qty qty">3<small>Products</small></div><div class="purelane-price price">₹499 <s>₹897</s></div><p class="purelane-body-s body-s" style="font-size:12px">Flat ₹166 per product</p><ul><li>Pick any three products</li><li>Covers kitchen and laundry</li><li>Free shipping across India</li></ul><a class="purelane-btn btn purelane-btn-primary btn-primary" href="#shop">Build this box</a></article><article class="purelane-glass glass purelane-tier tier rv"><span class="purelane-tag tag">Whole home</span><div class="purelane-tierpix tierpix five" aria-hidden="true"><span class="purelane-pimg pimg p-kitchen" role="img"></span><span class="purelane-pimg pimg p-tap" role="img"></span><span class="purelane-pimg pimg p-floor" role="img"></span><span class="purelane-pimg pimg p-toilet" role="img"></span><span class="purelane-pimg pimg p-laundry" role="img"></span></div><div class="purelane-qty qty">5<small>Products</small></div><div class="purelane-price price">₹799 <s>₹1495</s></div><p class="purelane-body-s body-s" style="font-size:12px">Flat ₹160 per product</p><ul><li>Pick any five products</li><li>Every room in one order</li><li>Free shipping across India</li></ul><a class="purelane-btn btn purelane-btn-ghost btn-ghost" href="#shop">Build this box</a></article>{%- endif -%}</div></div></section>
{% schema %}{"name":"Purelane Bundles","tag":"section","class":"purelane-bundles-section","settings":[{"type":"text","id":"kicker","label":"Kicker Text","default":"Build your bundle"},{"type":"text","id":"title","label":"Section Heading","default":"One box. Every room."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."}],"blocks":[{"type":"tier","name":"Bundle Tier Box","settings":[{"type":"text","id":"tag","label":"Tag Badge Label","default":"Starter"},{"type":"checkbox","id":"is_featured","label":"Highlight as Featured","default":false},{"type":"text","id":"product_count","label":"Product Count Number","default":"3"},{"type":"text","id":"price","label":"Tier Price","default":"₹499"},{"type":"text","id":"compare_price","label":"Compare Price","default":"₹897"},{"type":"text","id":"unit_note","label":"Unit Calculation Note","default":"Flat ₹166 per product"},{"type":"text","id":"feature_1","label":"Feature Bullet 1","default":"Pick any three products"},{"type":"text","id":"feature_2","label":"Feature Bullet 2","default":"Free shipping across India"},{"type":"text","id":"feature_3","label":"Feature Bullet 3"},{"type":"text","id":"btn_label","label":"Button Label","default":"Build this box"},{"type":"url","id":"btn_url","label":"Button Link"}]}],"presets":[{"name":"Purelane Bundles","blocks":[{"type":"tier","settings":{"tag":"Starter","is_featured":false,"product_count":"2","price":"₹349","compare_price":"₹598","unit_note":"Flat ₹174 per product"}},{"type":"tier","settings":{"tag":"Most popular","is_featured":true,"product_count":"3","price":"₹499","compare_price":"₹897","unit_note":"Flat ₹166 per product"}},{"type":"tier","settings":{"tag":"Whole home","is_featured":false,"product_count":"5","price":"₹799","compare_price":"₹1495","unit_note":"Flat ₹160 per product"}}]}]}
{% endschema %}