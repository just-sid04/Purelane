<section class="purelane-sec" data-scene="4"><div class="purelane-wrap"><div class="purelane-glass purelane-trust trust rv">{%- for block in section.blocks -%}{%- if block.type == 'trust' -%}<div class="trust-i" {{ block.shopify_attributes }}><span aria-hidden="true">{{ block.settings.icon | default: '✓' | escape }}</span><span>{{ block.settings.label | newline_to_br }}</span></div>{%- endif -%}{%- endfor -%}</div></div></section><section class="purelane-sec" data-scene="4"><div class="purelane-wrap"><div class="purelane-glass purelane-signup signup rv"><span class="purelane-kicker">{{ section.settings.signup_kicker | default: 'Join the Purelane Club' | escape }}</span><h2 class="purelane-d2" style="margin-top:12px">{{ section.settings.signup_heading | default: 'Get ₹100 off your first bundle' | escape }}</h2><p class="purelane-lede" style="margin:0 auto">{{ section.settings.signup_subtext | default: 'Plus first access to new launches and restocks.' | escape }}</p>{%- form 'customer', class: 'signup-form' -%}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder | default: 'your@email.com' | escape }}" aria-label="Email address" required><button class="purelane-btn purelane-btn-primary" type="submit">{{ section.settings.signup_button | default: 'Get my ₹100 off' | escape }}</button>{%- endform -%}</div></div></section><footer data-scene="4"><div class="purelane-wrap"><div class="fgrid"><div class="fcol"><a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px"><span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg></span><span class="txt"><span class="n1">{{ shop.name | escape }}</span><span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' | escape }}</span></span></a><p style="max-width:30ch">{{ section.settings.brand_description | default: 'Effective cleaning, powered by nature. Made for Indian homes.' | escape }}</p></div><div class="fcol"><h5>{{ section.settings.shop_heading | default: 'Shop' | escape }}</h5>{%- assign shop_menu = section.settings.shop_menu -%}{%- if shop_menu == blank -%}{%- assign shop_menu = linklists.main-menu -%}{%- endif -%}{%- for link in shop_menu.links limit: 8 -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}</div><div class="fcol"><h5>{{ section.settings.about_heading | default: 'About' | escape }}</h5>{%- assign about_menu = section.settings.about_menu -%}{%- if about_menu == blank -%}{%- assign about_menu = linklists.footer -%}{%- endif -%}{%- for link in about_menu.links limit: 8 -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}</div><div class="fcol"><h5>{{ section.settings.contact_heading | default: 'Get in touch' | escape }}</h5><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone | escape }}</a><p style="font-size:12px;color:rgba(236,230,247,.5)">{{ section.settings.legal_name | default: shop.name | escape }}</p></div></div><div class="fbot"><span>© {{ 'now' | date: '%Y' }} {{ section.settings.legal_name | default: shop.name | escape }}</span><span>{{ section.settings.legal_footer | default: 'Privacy · Terms · Refunds · Contact' | escape }}</span></div></div></footer><div class="purelane-sticky sticky"><span class="lbl"><b>{{ section.settings.sticky_title | default: 'Pick any 3, pay ₹499' | escape }}</b><span>{{ section.settings.sticky_subtitle | default: 'Free shipping, always' | escape }}</span></span><a class="purelane-btn purelane-btn-primary purelane-btn-sm" href="{{ section.settings.sticky_url | default: '#bundles' }}">{{ section.settings.sticky_button | default: 'Build bundle' | escape }}</a></div>{% schema %}{"name":"Purelane Footer & Club","tag":"section","class":"purelane-footer-section","settings":[{"type":"text","id":"signup_kicker","label":"Signup Kicker","default":"Join the Purelane Club"},{"type":"text","id":"signup_heading","label":"Signup Heading","default":"Get ₹100 off your first bundle"},{"type":"textarea","id":"signup_subtext","label":"Signup Subtext","default":"Plus first access to new launches and restocks."},{"type":"text","id":"signup_button","label":"Signup Button","default":"Get my ₹100 off"},{"type":"text","id":"email_placeholder","label":"Email Placeholder","default":"your@email.com"},{"type":"text","id":"brand_tagline","label":"Brand Tagline","default":"Clean, simply"},{"type":"textarea","id":"brand_description","label":"Brand Description","default":"Effective cleaning, powered by nature. Made for Indian homes."},{"type":"text","id":"shop_heading","label":"Shop Column Heading","default":"Shop"},{"type":"link_list","id":"shop_menu","label":"Shop Menu"},{"type":"text","id":"about_heading","label":"About Column Heading","default":"About"},{"type":"link_list","id":"about_menu","label":"About Menu"},{"type":"text","id":"contact_heading","label":"Contact Column Heading","default":"Get in touch"},{"type":"text","id":"email","label":"Contact Email","default":"hello@purelane.com"},{"type":"text","id":"phone","label":"Contact Phone","default":"+91 9930 123 234"},{"type":"text","id":"legal_name","label":"Legal Name","default":"Purelane Eco Products Pvt Ltd"},{"type":"text","id":"legal_footer","label":"Footer Legal Text","default":"Privacy · Terms · Refunds · Contact"},{"type":"text","id":"sticky_title","label":"Mobile Sticky CTA Title","default":"Pick any 3, pay ₹499"},{"type":"text","id":"sticky_subtitle","label":"Mobile Sticky CTA Subtitle","default":"Free shipping, always"},{"type":"text","id":"sticky_button","label":"Mobile Sticky CTA Button","default":"Build bundle"},{"type":"url","id":"sticky_url","label":"Mobile Sticky CTA Link","default":"/collections/all"}],"blocks":[{"type":"trust","name":"Trust Item","limit":4,"settings":[{"type":"text","id":"icon","label":"Icon / Symbol","default":"✓"},{"type":"textarea","id":"label","label":"Trust Label","default":"Plant derived formulas"}]}],"presets":[{"name":"Purelane Footer & Club","blocks":[{"type":"trust","settings":{"icon":"🌿","label":"Plant derived formulas"}},{"type":"trust","settings":{"icon":"♻","label":"Recyclable packaging"}},{"type":"trust","settings":{"icon":"♥","label":"Safe for kids & pets"}},{"type":"trust","settings":{"icon":"◉","label":"Made in India"}}]}]}
{% endschema %}