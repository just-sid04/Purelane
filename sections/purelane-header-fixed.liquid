{%- render 'purelane-background-scenes' -%}
<div class="purelane-ticker ticker" aria-hidden="true"><div class="purelane-track track">{%- for block in section.blocks -%}{%- if block.type == 'ticker' -%}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }} <b>{{ block.settings.emphasis | escape }}</b></span>{%- endif -%}{%- endfor -%}</div></div>
<header class="purelane-hdr" id="hdr">
  <div class="purelane-navpill navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ section.settings.brand_name | default: 'Purelane' | escape }} home"><span class="mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/><path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/></svg></span><span class="txt"><span class="n1">{{ section.settings.brand_name | default: shop.name | escape }}</span><span class="n2">{{ section.settings.brand_tagline | default: 'Clean, simply' | escape }}</span></span></a>
    <nav class="purelane-nav nav" aria-label="Main navigation">
      <a href="{{ routes.root_url }}">{{ section.settings.home_label | default: 'Home' | escape }}</a>
      {%- assign header_menu = section.settings.menu -%}
      {%- if header_menu != blank -%}
        {%- for link in header_menu.links limit: 8 -%}{%- unless link.url == routes.root_url -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endunless -%}{%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}#shop">Shop</a>
        <a href="{{ routes.root_url }}#ingredients">Ingredients</a>
        <a href="{{ routes.root_url }}#how">How it works</a>
        <a href="{{ routes.root_url }}#bundles">Bundles</a>
        <a href="{{ routes.root_url }}#reviews">Reviews</a>
      {%- endif -%}
    </nav>
    <div class="navtools"><a class="ico hide-s" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg></a><a class="ico" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg><span class="dot">{{ cart.item_count }}</span></a><button type="button" class="ico burger" aria-label="Open menu" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 8h16M4 16h16"/></svg></button></div>
  </div>
</header>
<nav class="purelane-rail rail" id="rail" aria-label="Section progress">{%- for block in section.blocks -%}{%- if block.type == 'rail' -%}<a href="{{ block.settings.url }}" aria-label="{{ block.settings.label | escape }}" class="{% if forloop.first %}on{% endif %}" {{ block.shopify_attributes }}></a>{%- endif -%}{%- endfor -%}</nav>
{% schema %}
{"name":"Purelane Header Fixed","tag":"section","class":"purelane-header-section","settings":[{"type":"text","id":"brand_name","label":"Brand Name","default":"Purelane"},{"type":"text","id":"brand_tagline","label":"Brand Tagline","default":"Clean, simply"},{"type":"text","id":"home_label","label":"Home Link Label","default":"Home"},{"type":"link_list","id":"menu","label":"Navigation Menu"}],"blocks":[{"type":"ticker","name":"Ticker Item","limit":8,"settings":[{"type":"text","id":"text","label":"Text","default":"Free shipping"},{"type":"text","id":"emphasis","label":"Emphasis","default":"on every bundle across India"}]},{"type":"rail","name":"Section Rail Dot","limit":8,"settings":[{"type":"text","id":"label","label":"Accessible Label","default":"Section"},{"type":"url","id":"url","label":"Section Link","default":"/"}]}],"presets":[{"name":"Purelane Header Fixed","blocks":[{"type":"ticker","settings":{"text":"Free shipping","emphasis":"on every bundle across India"}},{"type":"ticker","settings":{"text":"100% plant-based","emphasis":"and non-toxic"}},{"type":"ticker","settings":{"text":"Loved by","emphasis":"30,000+ happy homes"}},{"type":"ticker","settings":{"text":"Buy 3","emphasis":"at flat ₹499"}},{"type":"rail","settings":{"label":"Hero","url":"/#top"}},{"type":"rail","settings":{"label":"Ingredients","url":"/#ingredients"}},{"type":"rail","settings":{"label":"How it works","url":"/#how"}},{"type":"rail","settings":{"label":"Bundles","url":"/#bundles"}}]}]}
{% endschema %}