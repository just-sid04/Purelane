<section class="purelane-sec sec" id="collection"><div class="purelane-wrap wrap"><div class="purelane-panel-head panel-head rv"><span class="purelane-kicker kicker">Collection</span><h1 class="purelane-d2 d2" style="margin-top:12px">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<p class="purelane-lede lede" style="margin:14px auto 0">{{ collection.description }}</p>{% endif %}</div><div class="purelane-shelf shelf">{% paginate collection.products by section.settings.products_per_page %}{% for product in collection.products %}{% render 'purelane-product-card', product: product %}{% else %}<p class="purelane-body-s">No products found in this collection.</p>{% endfor %}<div style="grid-column:1/-1;text-align:center;margin-top:18px">{{ paginate | default_pagination }}</div>{% endpaginate %}</div></div></section>{% schema %}{"name":"Purelane Collection","tag":"section","class":"purelane-collection-section","settings":[{"type":"range","id":"products_per_page","label":"Products per page","min":4,"max":24,"step":4,"default":12}],"presets":[{"name":"Purelane Collection"}]}{% endschema %}